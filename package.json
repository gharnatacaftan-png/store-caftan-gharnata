{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:migrate:local": "wrangler d1 migrations apply caftan-gharnata-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply caftan-gharnata-db --remote",
    "d1:seed:local": "wrangler d1 execute caftan-gharnata-db --local --file cloudflare/seed_shipping.sql",
    "d1:seed:remote": "wrangler d1 execute caftan-gharnata-db --remote --file cloudflare/seed_shipping.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.0.0",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
