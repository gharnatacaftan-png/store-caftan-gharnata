# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.open-next/
/.wrangler/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
cloudflare-env.d.ts

# local editor/agent config
.claude/
.mimocode/

# prototype working files (screenshots, exports, scratch)
/cropped_circle_image*.png
/shipping-table-fr-*.png
/product-wilaya-select-fr.png
/583228101_*.jpg

# local dev data (JSON snapshots, may contain PII)
/data/
